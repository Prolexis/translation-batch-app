# Copia este archivo a ".env" y completa tu API Key real antes de levantar Docker.
# Obtén una clave gratuita en: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=coloca_aqui_tu_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

DEFAULT_SOURCE_LANG=auto
DEFAULT_TARGET_LANG=es

# --- Agente Validador ---
LENGTH_DIFF_THRESHOLD=0.40
MAX_RETRIES=2
MIN_UNTRANSLATED_WORD_LEN=4

# --- Agente de Alineación ---
ALIGNMENT_MODE=position
SEMANTIC_SIMILARITY_THRESHOLD=0.55

# --- Rate limiting / backoff ---
MAX_CALLS_PER_MINUTE=30
BACKOFF_BASE_SECONDS=2.0
BACKOFF_MAX_RETRIES=5
BACKOFF_MAX_SECONDS=60.0

MAX_CHARS_PER_SEGMENT=1200
